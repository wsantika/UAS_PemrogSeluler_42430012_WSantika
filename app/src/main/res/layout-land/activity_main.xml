<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/black_primary"
    android:padding="14dp"
    tools:context=".ui.main.MainActivity"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:id="@+id/layoutLeftPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HARLEY CATALOG"
            android:textColor="@color/orange_harley"
            android:textStyle="bold"
            android:textSize="24sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ride hard. Live free."
            android:textColor="@color/gray_text"
            android:textStyle="italic"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cari motor Harley..."
            android:inputType="text"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:textColor="@color/white_soft"
            android:textColorHint="@color/gray_text"
            android:background="@drawable/bg_search_dark"
            android:padding="12dp"
            android:layout_marginBottom="14dp"
            tools:ignore="TextFields,TextFieldSize" />

        <Button
            android:id="@+id/btnSortAZ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SORT A-Z"
            android:textStyle="bold"
            android:textColor="@color/white_soft"
            android:background="@drawable/bg_button_orange"
            android:layout_marginBottom="10dp"
            tools:ignore="ButtonStyle" />

        <Button
            android:id="@+id/btnSortZA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SORT Z-A"
            android:textStyle="bold"
            android:textColor="@color/white_soft"
            android:background="@drawable/bg_button_orange"
            android:layout_marginBottom="10dp"
            tools:ignore="ButtonStyle" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TAMBAH MOTOR"
            android:textStyle="bold"
            android:textColor="@color/white_soft"
            android:background="@drawable/bg_button_orange"
            tools:ignore="ButtonStyle" />

        <TextView
            android:id="@+id/tvLandscapeTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="American Power. Rebel Soul."
            android:textColor="@color/gray_text"
            android:textStyle="italic"
            android:textSize="12sp"
            android:layout_marginTop="18dp" />

    </LinearLayout>

    <!-- RIGHT PANEL: Motor list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMotor"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:clipToPadding="false"
        android:paddingStart="6dp"
        android:paddingBottom="8dp"
        tools:itemCount="6"
        tools:listitem="@layout/item_motor" />

</LinearLayout>