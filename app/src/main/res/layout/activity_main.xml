<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black_primary"
    android:padding="16dp"
    tools:context=".ui.main.MainActivity"
    tools:ignore="HardcodedText">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HARLEY CATALOG"
        android:textColor="@color/orange_harley"
        android:textStyle="bold"
        android:textSize="26sp"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvAppSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ride hard. Live free."
        android:textColor="@color/gray_text"
        android:textStyle="italic"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cari motor Harley..."
        android:inputType="text"
        android:singleLine="true"
        android:importantForAutofill="no"
        android:textColor="@color/white_soft"
        android:textColorHint="@color/gray_text"
        android:background="@drawable/bg_search_dark"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        tools:ignore="TextFields,TextFieldSize" />

    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnSortAZ"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A-Z"
            android:textStyle="bold"
            android:textColor="@color/white_soft"
            android:background="@drawable/bg_button_orange"
            android:layout_marginEnd="6dp"
            tools:ignore="ButtonStyle" />

        <Button
            android:id="@+id/btnSortZA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Z-A"
            android:textStyle="bold"
            android:textColor="@color/white_soft"
            android:background="@drawable/bg_button_orange"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            tools:ignore="ButtonStyle" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tambah"
            android:textStyle="bold"
            android:textColor="@color/white_soft"
            android:background="@drawable/bg_button_orange"
            android:layout_marginStart="6dp"
            tools:ignore="ButtonStyle" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMotor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:itemCount="6"
        tools:listitem="@layout/item_motor" />

</LinearLayout>