<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_primary"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgMotorDetail"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:background="@color/gray_metal"
            android:contentDescription="Gambar motor"
            tools:src="@drawable/iron883" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iron 883"
            android:textColor="@color/orange_harley"
            android:textStyle="bold"
            android:textSize="28sp"
            android:letterSpacing="0.04"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="American Power. Rebel Soul."
            android:textColor="@color/gray_text"
            android:textStyle="italic"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:id="@+id/detailInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type: Cruiser"
                android:textColor="@color/white_soft"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Year: 2021"
                android:textColor="@color/white_soft"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price: Rp350.000.000"
                android:textColor="@color/white_soft"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engine CC: 883"
                android:textColor="@color/white_soft"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDescTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION"
            android:textColor="@color/orange_harley"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deskripsi motor"
            android:textColor="@color/gray_text"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>