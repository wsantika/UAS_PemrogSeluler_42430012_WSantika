<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_primary"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD NEW RIDE"
            android:textColor="@color/orange_harley"
            android:textStyle="bold"
            android:textSize="28sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFormSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Build your rebel machine."
            android:textColor="@color/gray_text"
            android:textStyle="italic"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Form Card -->
        <LinearLayout
            android:id="@+id/formCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_dark"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOTOR IDENTITY"
                android:textColor="@color/orange_harley"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nama Motor"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:textColor="@color/white_soft"
                android:textColorHint="@color/gray_text"
                android:background="@drawable/bg_search_dark"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                tools:ignore="TextFields,TextFieldSize" />

            <EditText
                android:id="@+id/etType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tipe Motor"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:textColor="@color/white_soft"
                android:textColorHint="@color/gray_text"
                android:background="@drawable/bg_search_dark"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                tools:ignore="TextFields,TextFieldSize" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENGINE SPECS"
                android:textColor="@color/orange_harley"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tahun"
                android:inputType="number"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:textColor="@color/white_soft"
                android:textColorHint="@color/gray_text"
                android:background="@drawable/bg_search_dark"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                tools:ignore="TextFields,TextFieldSize" />

            <EditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Harga"
                android:inputType="number"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:textColor="@color/white_soft"
                android:textColorHint="@color/gray_text"
                android:background="@drawable/bg_search_dark"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                tools:ignore="TextFields,TextFieldSize" />

            <EditText
                android:id="@+id/etCC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="CC Mesin"
                android:inputType="number"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:textColor="@color/white_soft"
                android:textColorHint="@color/gray_text"
                android:background="@drawable/bg_search_dark"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                tools:ignore="TextFields,TextFieldSize" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STORY"
                android:textColor="@color/orange_harley"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etDesc"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:hint="Deskripsi motor"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:minLines="4"
                android:importantForAutofill="no"
                android:textColor="@color/white_soft"
                android:textColorHint="@color/gray_text"
                android:background="@drawable/bg_search_dark"
                android:padding="12dp"
                android:layout_marginBottom="18dp"
                tools:ignore="TextFields,TextFieldSize" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SIMPAN MOTOR"
                android:textStyle="bold"
                android:textColor="@color/white_soft"
                android:background="@drawable/bg_button_orange"
                android:padding="12dp"
                tools:ignore="ButtonStyle" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvFormFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Born to ride. Built to roar."
            android:textColor="@color/gray_text"
            android:textStyle="italic"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>